{
  "name": "dsh-zentao",
  "version": "0.1.0",
  "type": "module",
  "description": "ZenTao panel for DSH: list the requirements, tasks and bugs assigned to you through the REST API or zentao-cli, dispatch an agent on a branch you name, and write the outcome back.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "zentao",
    "禅道",
    "zentao-cli",
    "issue-tracker",
    "workflow",
    "agent"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-0 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/zentao.js",
    "lib/work.js",
    "lib/cli.js",
    "lib/writeback.js",
    "lib/store.js",
    "lib/checkout.js",
    "lib/dispatch.js",
    "lib/drafts.js",
    "lib/prompt.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-512.png",
    "docs/zentao-api-notes.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
